{
  "buildCommand": "npm --prefix SecureStash/client install && npm --prefix SecureStash/client run build",
  "outputDirectory": "SecureStash/client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://securestash.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
