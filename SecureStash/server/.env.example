# SecureStash Backend Environment Variables

# Server Port
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/securestash?retryWrites=true&w=majority

# JWT Secret Key for token signing
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Frontend Client URL for CORS (comma separated if multiple)
CLIENT_URL=http://localhost:5173
