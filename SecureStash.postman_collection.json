    {
      "name": "2. Folders",
      "item": [
        {
          "name": "Create Folder",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.folder && json.folder._id) {",
                  "        pm.environment.set('folderId', json.folder._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Work Documents\",\n  \"parentFolder\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/folders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "folders"
              ]
            }
          }
        },
        {
          "name": "Get All Folders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/folders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "folders"
              ]
            }
          }
        },
        {
          "name": "Rename Folder",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Work Documents\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/folders/{{folderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "folders",
                "{{folderId}}"
              ]
            }
          }
        },
        {
          "name": "Delete Folder",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/folders/{{folderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "folders",
                "{{folderId}}"
              ]
            },
            "description": "Deletes folder and moves contained files safely to root stash."
          }
        }
      ]
    },
    {
      "name": "3. Files",
      "item": [
        {
          "name": "Upload File (Multipart)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.file && json.file._id) {",
                  "        pm.environment.set('fileId', json.file._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                },
                {
                  "key": "folder",
                  "value": "{{folderId}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/files/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "files",
                "upload"
              ]
            }
          }
        },
